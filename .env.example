# Copiar a .env y completar. Nunca subir .env al repositorio.
ANTHROPIC_API_KEY=
MODELO=claude-haiku-4-5-20251001
MAX_TOKENS=1500
# Esfuerzo de razonamiento: low = mas barato
ESFUERZO=low
# Tope de consultas a NOVA por dia (red de seguridad para la API key)
NOVA_MAX_CHATS_DIA=400
# Puerto y host (127.0.0.1 = solo esta PC; 0.0.0.0 = visible en la red del aula)
# PORT=3000
# HOST=127.0.0.1

# Cuentas extra del instructor (opcional): usuario:DNI:Nombre:Nivel;...
# CUENTAS_INSTRUCTOR=profe:12345678:Nombre Apellido:Gold
# PASSWORD_INSTRUCTOR=

# Acceso restringido por IP (opcional): solo estas IP pueden entrar.
# IPS_PERMITIDAS=203.0.113.10,198.51.100.7
# Detras de un proxy (Render, Nginx, Cloudflare): numero de saltos para leer la IP real.
# TRUST_PROXY=1
